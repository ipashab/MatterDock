    },
    "MatterMac %@ is up to date.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "MatterDock %@ — актуальная версия."
          }
        }
      }
    },
    "MatterMac asks macOS for permission after you sign in.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "MatterDock запрашивает разрешение у macOS после входа."
          }
        }
      }
    },
    "MatterMac could not reach GitHub to check for updates.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "MatterDock не удалось связаться с GitHub для проверки обновлений."
          }
        }
      }
    },
    "MatterMac requests a private browser session. Your browser, macOS, and identity provider may retain their own sign-in data. Your organization’s SSO configuration has not been verified by MatterMac.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "MatterDock запрашивает частный сеанс браузера. Ваш браузер, macOS и провайдер удостоверений могут сохранять собственные данные входа. Конфигурация SSO вашей организации не проверялась MatterDock."
          }
        }
      }
    },
    "MatterMac supports up to %lld connected servers at once. Sign out of one first.": {
      "localizations": {
        "ru": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "MatterDock поддерживает до %lld подключённых серверов одновременно. Сначала выйдите из одного."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "MatterDock поддерживает до %lld подключённых серверов одновременно. Сначала выйдите из одного."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "MatterDock поддерживает до %lld подключённого сервера одновременно. Сначала выйдите из одного."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
